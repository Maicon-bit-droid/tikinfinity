const express = require('express');
const app = express();
const PORT = process.env.PORT || 3000;

// Middleware para interpretar JSON enviado no corpo da requisição
app.use(express.json());

// Rota para testar se a API está funcionando no navegador
app.get('/', (req, res) => {
  res.send('API do TikFinity está rodando!');
});

// Rota Webhook que receberá os dados do TikFinity via POST
app.post('/webhook', (req, res) => {
  console.log('Evento recebido do TikFinity:', req.body);
  
  // Responde com status 200 para indicar sucesso
  res.status(200).json({ status: 'success', message: 'Evento recebido!' });
});

app.listen(PORT, () => {
  console.log(Servidor rodando na porta ${PORT});
});
